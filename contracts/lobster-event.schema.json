{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowlever/lobster-event",
  "title": "KnowLever Lobster Event",
  "description": "Event emitted by KnowLever via polarclaw-project-sdk to SOTAgent lobster event bus.",
  "type": "object",
  "required": ["ts", "type", "source_project", "severity", "payload", "dedup_key"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "enum": ["bug", "contract_red", "build_error", "api_error", "ingest_error", "compile_error", "scheduled_health_scan"],
      "description": "KnowLever event types"
    },
    "source_project": { "type": "string", "const": "KnowLever" },
    "target_project": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "warning", "error", "critical"] },
    "payload": { "type": "object" },
    "dedup_key": { "type": "string" }
  },
  "additionalProperties": false
}
