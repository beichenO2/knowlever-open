{
  "name": "knowlever-open-source",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user simplified KnowLever — command-line compile, public examples only",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "compile": "node scripts/compile-7stage.js",
    "compile:force": "node scripts/compile-7stage.js --force",
    "normalize-formulas": "node lib/normalize-formulas.js",
    "vlm-ocr": "node lib/vlm-formula-ocr.js",
    "vlm-ocr:check": "node lib/vlm-formula-ocr.js --check",
    "office-import": "node scripts/office-import.js",
    "home": "node scripts/serve-home.js",
    "start": "node scripts/serve-home.js",
    "ingest": "node wiki-engine/ingest.js",
    "serve": "node wiki-engine/serve.js",
    "watch:compile": "node wiki-engine/watch-compile.js",
    "quality": "node wiki-engine/quality-metrics.js",
    "quality:json": "node wiki-engine/quality-metrics.js --json",
    "export:pdf": "node wiki-engine/export-pdf.js",
    "graph:build": "node enhancement/graph/build-graph.js",
    "clean": "python3 normalize/cleaner.py",
    "clean:dry": "python3 normalize/cleaner.py --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.0",
    "iconv-lite": "^0.7.2",
    "js-yaml": "^4.2.0",
    "puppeteer-core": "^24.0.0",
    "wiki-core": "file:./wiki-core"
  }
}
